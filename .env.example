# Legacy v1 app (app.py, config.py) - superseded by halludetect v2 below,
# still present until the migration in plan.md is complete.
GOOGLE_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

# halludetect v2 (src/halludetect/settings.py). All optional - each
# provider is only used if its key is set; none of these being set means
# the corresponding evidence/LLM source degrades to NOT_VERIFIABLE / no
# free-pool fallback rather than crashing.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=

# Web-search evidence source (docs/contract.md, Phase 0.2 decision: Tavily).
# Absence disables evidence_source: web - falls back to NOT_VERIFIABLE,
# never a guess.
TAVILY_API_KEY=

# Per-key auth for POST /v1/verify (Phase 5.2). Comma-separated list of
# valid client keys, distinct from the provider keys above - these
# authenticate a *caller* to this service, not this service to a provider.
# Empty/unset means every request is rejected with 401.
CLIENT_API_KEYS=

# Token-bucket rate limiting per client key (Phase 5.2). Optional - both
# default if unset (see settings.py).
RATE_LIMIT_CAPACITY=
RATE_LIMIT_REFILL_PER_S=
